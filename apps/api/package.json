{
  "name": "@klasr/api",
  "version": "0.1.0",
  "private": true,
  "description": "Klasr main API — NestJS, layered architecture (controller/service/repository)",
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "worker:dev": "nest start --entryFile worker",
    "dsa:filename": "pnpm build && node dist/analysis/cli.js filename",
    "dsa:destination": "pnpm build && node dist/analysis/cli.js destination",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.3",
    "@nestjs/common": "^10.3.9",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.9",
    "@nestjs/platform-express": "^10.3.9",
    "@prisma/client": "^5.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.1",
    "mongodb": "^7.5.0",
    "pdfjs-dist": "6.2.108",
    "pg-boss": "12.26.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tesseract.js": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.16.1",
    "ts-jest": "29.4.11",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
