# Klasr API local environment.
# Copy this file to apps/api/.env. Never commit the real .env file.

# Full backend verification values: start Docker services and the API.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:***@localhost:5432/klasr
MONGO_URL=mongodb://localhost:27017

# Must match apps/web/.env.local INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=replace-with-a-local-shared-secret

# 32 random bytes encoded as base64 or 64 hex chars. Never commit a real key.
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Local MVP is deterministic and forbidden in production.
KLASR_LOCAL_MVP=false
KLASR_ACCEPTANCE_GOOGLE_SERVICE_ACCOUNT=false
KLASR_GOOGLE_SERVICE_ACCOUNT_FILE=
KLASR_GOOGLE_DRIVE_ROOT_ID=
KLASR_INLINE_WORKER=false

# Optional real Google OAuth setup.
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Optional real API setup: leave blank for local heuristic classification.
ANTHROPIC_API_KEY=
