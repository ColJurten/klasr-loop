DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klasr
MONGO_URL=mongodb://localhost:27017
ANTHROPIC_API_KEY=
PORT=3001

# Shared secret for internal-service-only endpoints (e.g. POST /auth/onboarding,
# POST /drive-connections) called by the web app's server-side routes. Must
# match apps/web's INTERNAL_API_SECRET exactly. Generate with:
# openssl rand -base64 32
INTERNAL_API_SECRET=changeme-generate-a-long-random-secret

# AES-256-GCM key encrypting Drive refresh tokens at rest (drive-connections
# module). Base64-encoded 32 bytes. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-base64-32
