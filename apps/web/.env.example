# Klasr web — local dev environment. Copy to .env.local and fill in real
# values. NEVER commit the real .env.local file.

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (Google Cloud Console / Azure AD app registration).
# The Google client is also reused for the org-level "Connect Drive" grant
# (apps/web/app/api/drive/*) — its Cloud Console entry needs the drive.file
# scope added to the consent screen and NEXTAUTH_URL + "/api/drive/callback"
# added as an authorized redirect URI. See docs/ARCHITECTURE.md ADR-007.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
AZURE_AD_CLIENT_ID=changeme
AZURE_AD_CLIENT_SECRET=changeme
AZURE_AD_TENANT_ID=common

# Klasr API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Shared secret for internal-service-only API endpoints (e.g.
# POST /auth/onboarding, called from the jwt() callback on first sign-in).
# Must match apps/api's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=changeme-generate-a-long-random-secret
