# Klasr web local environment.
# Copy this file to apps/web/.env.local. Never commit the real .env.local file.

# Credential-free /demo needs only the web app.
# No API, database, MongoDB, OAuth, or provider key is required.
NEXTAUTH_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_SECRET=replace-with-a-local-nextauth-secret

# Must match apps/api/.env INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=replace-with-a-local-shared-secret

# Visual/test-only label for the deterministic local sign-in button.
KLASR_LOCAL_MVP=false
NEXT_PUBLIC_KLASR_LOCAL_MVP=false
KLASR_ACCEPTANCE_GOOGLE_SERVICE_ACCOUNT=false
NEXT_PUBLIC_KLASR_ACCEPTANCE_GOOGLE_SERVICE_ACCOUNT=false

# Provider keys are entered in Settings and stored encrypted by the API; never put them here.

# Low-confidence/review-required proposals are shown in the dashboard and excluded
# from Tout valider until the user corrects name and destination.

# Optional real OAuth setup: replace with values from Google Cloud / Azure.
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
AZURE_AD_CLIENT_ID=placeholder-azure-client-id
AZURE_AD_CLIENT_SECRET=placeholder-azure-client-secret
AZURE_AD_TENANT_ID=common
