# Runtime
KLASR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/klasr
# Test-only alternative; SQLite drops SKIP LOCKED, partial indexes, JSONB and TEXT[].
# KLASR_DATABASE_URL=sqlite:///./klasr.db
KLASR_MONGO_URL=mongodb://localhost:27017
KLASR_MONGO_DATABASE=klasr
KLASR_ANALYSES_TTL_DAYS=30
KLASR_INLINE_WORKER=false
KLASR_WORKER=false
KLASR_LOCAL_MVP=false
INTERNAL_API_SECRET=replace-with-a-local-shared-secret
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-hex-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# LLM (no default model; key may be empty for providers that do not require one)
KLASR_LLM_PROVIDER=
KLASR_LLM_MODEL=
KLASR_LLM_API_KEY=
KLASR_LLM_BASE_URL=
# Optional overrides: replace AGENT with ANALYSE_FILE_AGENT,
# SUGGEST_FILENAME_AGENT, or SUGGEST_DIRECTORY_AGENT.
# KLASR_LLM_PROVIDER_<AGENT>=
# KLASR_LLM_MODEL_<AGENT>=
# KLASR_LLM_API_KEY_<AGENT>=
# KLASR_LLM_BASE_URL_<AGENT>=

# DSA output controls. Verbose is ignored when KLASR_CONTAINER=true.
KLASR_DSA_VERBOSE=false
KLASR_CONTAINER=false
